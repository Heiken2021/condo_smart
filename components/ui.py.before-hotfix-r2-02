import base64,pandas as pd,streamlit as st
from core.formatting import labels,state,money
def title(t,s=''):st.title(t);st.caption(s) if s else None
def table(rows,entity,visible):
 d=pd.DataFrame(rows or [])
 if d.empty:st.info('Sin Registros');return d
 d=d[[c for c in visible if c in d.columns]]
 if 'activo' in d.columns:d['activo']=d['activo'].map(state)
 d=d.rename(columns=labels(entity));st.dataframe(d,hide_index=True,use_container_width=True);return d
def metrics(items):
 for c,(a,b) in zip(st.columns(len(items)),items):c.metric(a,b)
def datauri(data,mime='image/jpeg'):return 'data:'+mime+';base64,'+base64.b64encode(bytes(data)).decode() if data else ''
def property_header(p):
 if not p:return
 a,b=st.columns([1,3])
 with a:
  if p.get('logo_data'):st.image(p['logo_data'],width=130)
 with b:
  st.subheader(p.get('nombre',''));st.caption(' · '.join(filter(None,[p.get('tipo_codigo'),p.get('direccion')])) )
 if p.get('portada_data'):st.image(p['portada_data'],use_container_width=True)
