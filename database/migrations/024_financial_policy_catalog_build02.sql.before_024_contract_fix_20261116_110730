-- ============================================================
-- PAGO MINIMO PARCIAL
-- ============================================================

INSERT INTO financial_rule_definitions (
    codigo,
    nombre,
    descripcion,
    dominio_codigo,
    nivel_base_codigo,
    tipo_resultado,
    esquema_parametros,
    obligatoria,
    admite_especializacion,
    admite_herencia,
    admite_override,
    admite_excepcion,
    requiere_aprobacion,
    permite_nivel_inmueble,
    permite_nivel_estructura,
    permite_nivel_espacio,
    contexto_kpi,
    contexto_ia,
    activo
)
SELECT
    'PAGO_MINIMO_PARCIAL',
    'Pago mínimo parcial',
    (
        'Gobierna el porcentaje mínimo de una '
        'obligación que debe cubrirse para '
        'considerar cumplido el mínimo financiero.'
    ),
    'COBRANZA',
    'CORE',
    'POLICY',
    jsonb_build_object(
        'minimum_payment_percentage',
        jsonb_build_object(
            'type', 'number',
            'minimum', 0,
            'maximum', 100,
            'unit', 'PERCENT'
        ),
        'minimum_compliance',
        jsonb_build_object(
            'type', 'boolean'
        )
    ),
    FALSE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE,
    TRUE
WHERE NOT EXISTS (
    SELECT 1
    FROM financial_rule_definitions
    WHERE codigo='PAGO_MINIMO_PARCIAL'
);


INSERT INTO financial_rule_applicability (
    rule_definition_id,
    dimension_codigo,
    valor_codigo,
    incluido
)
SELECT
    d.id,
    'TIPO_INMUEBLE',
    'FRACCIONAMIENTO',
    TRUE
FROM financial_rule_definitions d
WHERE d.codigo='PAGO_MINIMO_PARCIAL'
  AND NOT EXISTS (
      SELECT 1
      FROM financial_rule_applicability a
      WHERE
          a.rule_definition_id=d.id
          AND a.dimension_codigo='TIPO_INMUEBLE'
          AND a.valor_codigo='FRACCIONAMIENTO'
          AND a.incluido=TRUE
  );


