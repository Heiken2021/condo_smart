    codigo VARCHAR(80)
        NOT NULL,

    nombre VARCHAR(200)
        NOT NULL,

    descripcion TEXT,

    parametros JSONB
        NOT NULL
        DEFAULT '{}'::jsonb,

    vigente_desde DATE NOT NULL,
    vigente_hasta DATE,

    estado_codigo VARCHAR(30)
        NOT NULL
        DEFAULT 'BORRADOR',

    prioridad INTEGER
        NOT NULL
        DEFAULT 100,

    hereda BOOLEAN
        NOT NULL
        DEFAULT TRUE,

    creado_por BIGINT
        REFERENCES usuarios(id),

    aprobado_por BIGINT
        REFERENCES usuarios(id),

    aprobado_en TIMESTAMPTZ,

    motivo_cambio TEXT,

