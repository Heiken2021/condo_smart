def _can_manage(
    user,
    property_id,
):
    return authorize(
        user,
        "FINANZAS_REGLA_GESTIONAR",
        property_id,
    ).allowed


def _can_approve(
    user,
    property_id,
):
    return authorize(
        user,
        "FINANZAS_REGLA_APROBAR",
        property_id,
    ).allowed


def _action_key(
    property_id,
):
    return (
        f"governance_rule_action_"
        f"{property_id}"
    )


def _set_action(
    property_id,
    action,
):
    st.session_state[
        _action_key(property_id)
    ] = action


def _clear_action(
    property_id,
):
    st.session_state.pop(
        _action_key(property_id),
        None,
    )


def _next_version(detail):
    versions = (
        detail.get("versions")
        or []
    )

    if not versions:
        return 1

    return max(
        int(
            version["version_num"]
        )
        for version in versions
    ) + 1


def _render_scope_fields(
    *,
    property_id,
    detail,
):
    scope = st.selectbox(
        "Alcance",
        [
            "INMUEBLE",
            "ESTRUCTURA",
            "ESPACIO",
        ],
        key=(
            f"rule_new_scope_"
            f"{property_id}"
        ),
        help=HELP["scope"],
    )

    structure_id = None
    space_id = None

    if scope == "ESTRUCTURA":
        structure_id = st.number_input(
            "ID de estructura",
            min_value=1,
            step=1,
            key=(
                f"rule_structure_"
                f"{property_id}"
            ),
            help=(
                "Identificador de la estructura "
                "jerárquica donde aplicará "
                "la regla."
            ),
        )

    if scope == "ESPACIO":
        space_id = st.number_input(
            "ID de espacio",
            min_value=1,
            step=1,
            key=(
                f"rule_space_"
                f"{property_id}"
            ),
            help=(
                "Identificador del espacio "
                "específico donde aplicará "
                "la regla."
            ),
        )

    return (
        scope,
        (
            int(structure_id)
            if structure_id
            else None
        ),
        (
            int(space_id)
            if space_id
            else None
        ),
    )


def _render_create_rule(
    *,
    property_id,
    user,
    detail,
):
    st.markdown("### Nueva regla")

    st.info(
        "Esta operación creará la configuración "
        "de la regla. Después se deberá crear "
        "su primera versión."
    )

    with st.form(
        f"create_rule_{property_id}"
    ):
        code = st.text_input(
            "Código",
            value=(
                detail[
                    "definition_code"
                ]
            ),
        )

        name = st.text_input(
            "Nombre",
            value=(
                detail[
                    "definition_name"
                ]
            ),
        )

        description = st.text_area(
            "Descripción",
            value=(
                detail.get(
                    "definition_description"
                )
                or ""
            ),
        )

        scope, structure_id, space_id = (
            _render_scope_fields(
                property_id=property_id,
                detail=detail,
            )
        )

        applicable_type = st.text_input(
            "Tipo aplicable",
            value=(
                detail.get(
                    "property_type"
                )
                or ""
            ),
        )

        inherits = st.toggle(
            "Hereda configuración",
            value=True,
            help=HELP["inheritance"],
        )

        is_override = st.toggle(
            "Es override",
            value=False,
            help=HELP["override"],
        )

        priority_level = st.selectbox(
            "Prioridad de aplicación",
            PRIORITY_LEVELS,
            index=1,
            help=HELP["priority"],
        )

        priority = PRIORITY_VALUES[
            priority_level
        ]

        st.caption(
            PRIORITY_DESCRIPTIONS[
                priority_level
            ]
        )

        st.caption(
            "Orden de resolución: alcance más "
            "específico → override explícito → "
            "prioridad de aplicación."
        )

        col_save, col_cancel = (
            st.columns(2)
        )

        with col_save:
            submitted = (
                st.form_submit_button(
                    "Crear regla",
                    type="primary",
                )
            )

        with col_cancel:
            cancel = (
                st.form_submit_button(
                    "Cancelar"
                )
            )

    if cancel:
        _clear_action(property_id)
        st.rerun()

    if not submitted:
        return

    try:
        create_financial_rule(
            property_id=property_id,
            definition_id=detail[
                "definition_id"
            ],
            scope_level=scope,
            code=code.strip(),
            name=name.strip(),
            actor_id=user["id"],
            structure_id=structure_id,
            space_id=space_id,
            applicable_type=(
                applicable_type.strip()
                or None
            ),
            description=(
                description.strip()
                or None
            ),
            inherits=inherits,
            is_override=is_override,
            priority=priority,
        )

    except Exception as exc:
        st.error(
            "No fue posible crear "
            f"la regla: {exc}"
        )
        return

    _clear_action(property_id)

    st.success(
        "Regla creada correctamente. "
        "El siguiente paso es crear "
        "su primera versión."
    )

    st.rerun()


def _render_version_form(
    *,
    property_id,
    user,
    detail,
    version_num,
):
    st.markdown(
        f"### Crear versión v{version_num}"
    )

    schema = (
        detail.get(
            "esquema_parametros"
        )
        or {}
    )

    with st.form(
        f"create_version_"
        f"{property_id}_"
        f"{detail['rule_id']}_"
        f"{version_num}"
    ):
        parameters = (
            render_parameter_inputs(
                schema=schema,
                current_values={},
                key_prefix=(
                    f"new_version_"
                    f"{property_id}_"
                    f"{detail['rule_id']}_"
                    f"{version_num}"
                ),
            )
        )

        effective_from = st.date_input(
            "Vigente desde",
            value=date.today(),
        )

        use_end = st.checkbox(
            "Definir fecha de término",
            value=False,
        )

        effective_to = None

        if use_end:
            effective_to = st.date_input(
                "Vigente hasta",
                value=date.today(),
            )

        reason = st.text_input(
            "Motivo del cambio",
            value=(
                "Configuración inicial "
                "de la regla"
                if version_num == 1
                else
                "Nueva versión de la regla"
            ),
        )

        save, cancel_col = (
            st.columns(2)
        )

        with save:
            submitted = (
                st.form_submit_button(
                    "Crear versión en borrador",
                    type="primary",
                )
            )

        with cancel_col:
            cancel = (
                st.form_submit_button(
                    "Cancelar"
                )
            )

    if cancel:
        _clear_action(property_id)
        st.rerun()

    if not submitted:
        return

    try:
        create_rule_version(
            property_id=property_id,
            rule_id=detail["rule_id"],
            version_num=version_num,
            effective_from=effective_from,
            parameters=parameters,
            actor_id=user["id"],
            effective_to=effective_to,
            change_reason=(
                reason.strip()
                or None
            ),
        )

    except Exception as exc:
        st.error(
            "No fue posible crear "
            f"la versión: {exc}"
        )
        return

    _clear_action(property_id)

    st.success(
        f"Versión v{version_num} "
        "creada en borrador."
    )

    st.rerun()


def _draft_version(detail):
    for version in (
        detail.get("versions")
        or []
    ):
        if (
            version[
                "estado_codigo"
            ]
            == "BORRADOR"
        ):
            return version

    return None


def _approved_version(detail):
    for version in (
        detail.get("versions")
        or []
    ):
        if (
            version[
                "estado_codigo"
            ]
            == "APROBADO"
        ):
            return version

    return None



def _render_edit_draft(
    *,
    property_id,
    user,
    detail,
):
    draft = _draft_version(detail)

    if not draft:
        st.warning(
            "No existe una versión en borrador "
            "para editar."
        )
        return

    schema = (
        detail.get(
            "esquema_parametros"
        )
        or {}
    )

    current = (
        draft.get("parametros")
        or {}
    )

    st.markdown(
        f"### Editar borrador "
        f"v{draft['version_num']}"
    )

    st.info(
        "Puedes modificar los valores mientras "
        "la versión permanezca en Borrador. "
        "Después de aprobarla, cualquier cambio "
        "deberá realizarse mediante una nueva "
        "versión."
    )

    with st.form(
        f"edit_rule_draft_{draft['id']}"
    ):
        parameters = (
            render_parameter_inputs(
                schema=schema,
                current_values=current,
                key_prefix=(
                    f"edit_version_"
                    f"{property_id}_"
                    f"{draft['id']}"
                ),
            )
        )

        effective_from = st.date_input(
            "Vigente desde",
            value=draft[
                "vigente_desde"
            ],
        )

        use_end = st.checkbox(
            "Definir fecha de término",
            value=(
                draft["vigente_hasta"]
                is not None
            ),
        )

        effective_to = None

        if use_end:
            effective_to = st.date_input(
                "Vigente hasta",
                value=(
                    draft["vigente_hasta"]
                    or effective_from
                ),
            )

        reason = st.text_input(
            "Motivo de modificación",
            value=(
                draft.get(
                    "motivo_cambio"
                )
                or
                "Ajuste del borrador"
            ),
        )

        save_column, cancel_column = (
            st.columns(2)
        )

        with save_column:
            submitted = (
                st.form_submit_button(
                    "Guardar cambios",
                    type="primary",
                )
            )

        with cancel_column:
            cancel = (
                st.form_submit_button(
                    "Cancelar"
                )
            )

    if cancel:
        _clear_action(property_id)
        st.rerun()

    if not submitted:
        return

    try:
        update_rule_version_draft(
            property_id=property_id,
            version_id=draft["id"],
            effective_from=effective_from,
            parameters=parameters,
            actor_id=user["id"],
            effective_to=effective_to,
            change_reason=(
                reason.strip()
                or None
            ),
        )

    except Exception as exc:
        st.error(
            "No fue posible actualizar "
            f"el borrador: {exc}"
        )
        return

    _clear_action(property_id)

    st.success(
        "Borrador actualizado correctamente."
    )

    st.rerun()


def _render_approval(
    *,
    property_id,
    user,
    detail,
):
    draft = _draft_version(detail)

    if not draft:
        st.warning(
            "No existe una versión "
            "en borrador para aprobar."
        )
        return

    st.markdown(
        f"### Aprobar versión "
        f"v{draft['version_num']}"
    )

    reason = st.text_input(
        "Motivo de aprobación",
        value="Regla revisada y aprobada",
        key=(
            f"approve_rule_reason_"
            f"{property_id}_"
            f"{draft['id']}"
        ),
    )

    approve, cancel = st.columns(2)

    with approve:
        clicked = st.button(
            "Confirmar aprobación",
            type="primary",
            key=(
                f"approve_rule_confirm_"
                f"{draft['id']}"
            ),
        )

    with cancel:
        cancel_clicked = st.button(
            "Cancelar",
            key=(
                f"approve_rule_cancel_"
                f"{draft['id']}"
            ),
        )

    if cancel_clicked:
        _clear_action(property_id)
        st.rerun()

    if not clicked:
        return

    try:
        approve_rule_version(
            property_id=property_id,
            version_id=draft["id"],
            actor_id=user["id"],
            approval_reason=(
                reason.strip()
            ),
        )

    except Exception as exc:
        st.error(
            "No fue posible aprobar "
            f"la versión: {exc}"
        )
        return

    _clear_action(property_id)

    st.success(
        "Versión aprobada correctamente."
    )

    st.rerun()


