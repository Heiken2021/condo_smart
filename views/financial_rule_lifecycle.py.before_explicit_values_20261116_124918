def render_rule_lifecycle_actions(
    *,
    property_id,
    user,
    detail,
):
    can_manage = _can_manage(
        user,
        property_id,
    )

    can_approve = _can_approve(
        user,
        property_id,
    )

    configured = bool(
        detail.get("rule_id")
    )

    draft = _draft_version(detail)
    approved = _approved_version(
        detail
    )

    buttons = st.columns(6)

    with buttons[0]:
        if st.button(
            "Nueva regla",
            disabled=(
                not can_manage
                or configured
            ),
            use_container_width=True,
        ):
            _set_action(
                property_id,
                "CREATE_RULE",
            )

    with buttons[1]:
        if st.button(
            "Editar borrador",
            disabled=(
                not can_manage
                or draft is None
            ),
            help=(
                "Disponible únicamente mientras "
                "exista una versión en Borrador."
            ),
            use_container_width=True,
        ):
            _set_action(
                property_id,
                "EDIT_DRAFT",
            )

    with buttons[2]:
        if st.button(
            "Nueva versión",
            disabled=(
                not can_manage
                or not configured
                or draft is not None
            ),
            use_container_width=True,
        ):
            _set_action(
                property_id,
                "NEW_VERSION",
            )

    with buttons[3]:
        if st.button(
            "Aprobar",
            disabled=(
                not can_approve
                or draft is None
            ),
            use_container_width=True,
        ):
            _set_action(
                property_id,
                "APPROVE",
            )

    with buttons[4]:
        if st.button(
            "Finalizar vigencia",
            disabled=(
                not can_manage
                or approved is None
            ),
            use_container_width=True,
        ):
            _set_action(
                property_id,
                "CLOSE",
            )

    with buttons[5]:
        if st.button(
            "Auditoría",
            use_container_width=True,
        ):
            _set_action(
                property_id,
                "AUDIT",
            )

    action = st.session_state.get(
        _action_key(property_id)
    )

    if action == "CREATE_RULE":
        _render_create_rule(
            property_id=property_id,
            user=user,
            detail=detail,
        )

    elif action == "EDIT_DRAFT":
        _render_edit_draft(
            property_id=property_id,
            user=user,
            detail=detail,
        )

    elif action == "NEW_VERSION":
        _render_version_form(
            property_id=property_id,
            user=user,
            detail=detail,
            version_num=(
                _next_version(detail)
            ),
        )

    elif action == "APPROVE":
        _render_approval(
            property_id=property_id,
            user=user,
            detail=detail,
        )

    elif action == "CLOSE":
        _render_close(
            property_id=property_id,
            user=user,
            detail=detail,
        )

    elif action == "AUDIT":
        st.info(
            "La auditoría consolidada de esta "
            "regla se incorporará en el siguiente "
            "bloque de trazabilidad. Las operaciones "
            "del lifecycle ya generan auditoría "
            "mediante los comandos gobernados."
        )

