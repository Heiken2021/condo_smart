def _help_popover(text):
    with st.popover(
        "ⓘ",
        type="tertiary",
        help="Más información",
    ):
        st.write(text)


def _yes_no(value):
    return "Sí" if value else "No"


def render_governance_attribute(
    label,
    value,
    help_key,
):
    left, info, result = st.columns(
        [3.3, 0.5, 1.2],
        vertical_alignment="center",
    )

    with left:
        st.markdown(
            f"**{label}**"
        )

    with info:
        _help_popover(
            HELP[help_key]
        )

    with result:
        st.markdown(
            f"**{_yes_no(value)}**"
        )


