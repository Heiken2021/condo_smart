def render_definition_field(
    label,
    value,
):
    label_column, info_column = st.columns(
        [5.4, 0.6],
        vertical_alignment="center",
    )

    with label_column:
        st.markdown(
            f"**{label}:** "
            f"{value if value not in (None, '') else '—'}"
        )

    with info_column:
        with st.popover(
            "ⓘ",
            type="tertiary",
            help=(
                f"Información sobre {label}"
            ),
        ):
            st.write(
                DEFINITION_HELP[label]
