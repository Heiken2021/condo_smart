def _cancellation_section(
    property_id,
    user,
    movement_type,
    movement,
):
    if not _decision(
        user,
        "FINANZAS_MOVIMIENTO_CANCELAR",
        property_id,
    ).allowed:
        return

    st.markdown("---")
    st.markdown(
        "**Cancelación del movimiento seleccionado**"
    )

    st.warning(
        "La cancelación conserva el movimiento original y genera trazabilidad financiera."
    )

    reason = st.text_area(
        "Motivo de cancelación",
        key=(
            f"finance_cancel_reason_"
            f"{movement_type}_"
            f"{movement['id']}"
        ),
    )

    confirm = st.checkbox(
        "Confirmo la cancelación del movimiento",
        key=(
            f"finance_cancel_confirm_"
            f"{movement_type}_"
            f"{movement['id']}"
        ),
    )

    if st.button(
        "Cancelar Movimiento",
        disabled=not confirm,
        key=(
            f"finance_cancel_button_"
            f"{movement_type}_"
            f"{movement['id']}"
        ),
    ):
        try:
            cancel_movement(
                property_id,
                movement_type,
                movement["id"],
                reason,
                user["id"],
            )

            st.success(
                "Movimiento cancelado "
                "correctamente."
            )
            st.rerun()

        except Exception as exc:
            st.error(
                "No fue posible cancelar el "
                f"movimiento: {exc}"
            )


def _statement_section(
    property_id,
    user,
    period,
    spaces,
):
    if not _decision(
        user,
        "FINANZAS_ESTADO_CUENTA",
        property_id,
    ).allowed:
        _denied("FINANZAS_ESTADO_CUENTA")
        return

    st.subheader("Estado de Cuenta")

    if not spaces:
        st.info(
            "No existen espacios activos para "
            "consultar estados de cuenta."
        )
        return

    labels = list(spaces)

    selected_label = st.selectbox(
        "Espacio",
        labels,
        key=f"finance_statement_space_{property_id}",
    )

    selected_space = spaces[
        selected_label
    ]

    statement = account_statement(
        property_id,
        selected_space["id"],
        user["id"],
        period=period or None,
    )

    metrics(
        [
            (
                "Cargos",
                money(
                    statement[
                        "total_charges"
                    ]
                ),
            ),
            (
                "Pagos",
                money(
                    statement[
                        "total_payments"
                    ]
                ),
            ),
            (
                "Saldo",
                money(
                    statement["balance"]
                ),
            ),
        ]
    )

    movements = []

    for row in statement["charges"]:
        movements.append(
            {
                "Fecha": row.get(
                    "fecha_movimiento"
                ),
                "Periodo": row.get("periodo"),
                "Movimiento": "Cargo",
                "Concepto": row.get("concepto"),
                "Referencia": (
                    row.get("referencia") or ""
                ),
                "Cargo": money(
                    row.get("monto_mxn")
                ),
                "Pago": "",
            }
        )

    for row in statement["payments"]:
        movements.append(
            {
                "Fecha": row.get(
                    "fecha_movimiento"
                ),
                "Periodo": row.get("periodo"),
                "Movimiento": "Pago",
                "Concepto": row.get("concepto"),
                "Referencia": (
                    row.get("referencia") or ""
                ),
                "Cargo": "",
                "Pago": money(
                    row.get("monto_mxn")
                ),
            }
        )

    if not movements:
        st.info(
            "El espacio seleccionado no tiene "
            "movimientos para el periodo."
        )
        return

    dataframe = pd.DataFrame(movements)

    if "Fecha" in dataframe.columns:
        dataframe = dataframe.sort_values(
            by=["Fecha", "Movimiento"],
            ascending=[True, True],
            na_position="first",
        )

    st.dataframe(
        dataframe,
        hide_index=True,
        use_container_width=True,
    )


def render():
    property_id = cid()

    if not property_id:
        st.info(
            "Selecciona un inmueble para "
            "gestionar sus finanzas."
        )
        return

    user = st.session_state.get(
        "user",
        {},
    )

    property_data = st.session_state.get(
        "condominio",
        {},
    )

    title(
        "Finanzas",
        property_data.get(
            "nombre",
            "Inmueble Activo",
        ),
    )

    property_header(
        property_data
    )

    if not _decision(
        user,
        "FINANZAS_CONSULTAR",
        property_id,
    ).allowed:
        _denied("FINANZAS_CONSULTAR")
        return

    filter_col, clear_col = st.columns(
        [2, 1]
    )

    period = filter_col.text_input(
        "Periodo",
        value=_period_default(),
        placeholder="AAAA-MM",
        key=f"finance_period_{property_id}",
    ).strip()

    if clear_col.button(
        "Todos los periodos",
        use_container_width=True,
        key=f"finance_all_periods_{property_id}",
    ):
        st.session_state[
            f"finance_period_{property_id}"
        ] = ""
        st.rerun()

    if period:
        if (
            len(period) != 7
            or period[4] != "-"
            or not period[:4].isdigit()
            or not period[5:].isdigit()
            or not 1 <= int(period[5:]) <= 12
        ):
            st.warning(
                "El periodo debe utilizar "
                "el formato AAAA-MM."
            )
            return

    scope, allowed_space_ids = (
        _scope_contract(
            property_id
        )
    )

    _scope_caption(scope)

