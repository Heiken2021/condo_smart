def _decision(user, permission, property_id):
    return authorize(
        user,
        permission,
        property_id,
    )


def _denied(permission):
    st.warning(
        "Sin permiso para esta operación: "
        + permission
    )


def _space_options(
    property_id,
    allowed_space_ids=None,
):
    allowed = (
        set(allowed_space_ids)
        if allowed_space_ids is not None
        else None
    )

    rows = [
        row
        for row in list_spaces(property_id)
        if (
            row.get("activo")
            and (
                allowed is None
                or row["id"] in allowed
            )
        )
    ]

    mapping = {}

    for row in rows:
        label = (
            f"{row.get('clave') or 'S/C'} · "
            f"{row.get('nombre') or 'Sin nombre'}"
        )

        mapping[label] = row

    return mapping




def _scope_contract(
    property_id,
):
    options = financial_scope_options(
        property_id
    )

    mapping = {
        option["label"]: option
        for option in options
    }

    labels = list(mapping)

    selected_label = st.selectbox(
        "Alcance financiero",
        labels,
        key=f"finance_scope_{property_id}",
        help=(
            "Selecciona todo el inmueble, "
            "espacios directos o una estructura."
        ),
    )

    selected = mapping[
        selected_label
    ]

    space_ids = financial_scope_space_ids(
        property_id,
        selected["kind"],
        structure_id=selected.get(
            "structure_id"
        ),
    )

    return selected, set(space_ids)


def _rows_in_scope(
    rows,
    allowed_space_ids,
):
    return [
        row
        for row in rows
        if row.get("espacio_id")
        in allowed_space_ids
    ]


def _scope_caption(scope):
    if scope["kind"] == "ALL":
        st.caption(
            "Vista consolidada de todo el inmueble."
        )
        return

    if scope["kind"] == "DIRECT":
        st.caption(
            "Vista limitada a espacios asociados "
            "directamente al inmueble."
        )
        return

    st.caption(
        "Vista financiera aislada para la "
        "estructura seleccionada y todos sus "
        "descendientes."
    )

def _period_default():
    today = date.today()
    return f"{today.year:04d}-{today.month:02d}"


def _summary_section(
    property_id,
    user,
    period,
    scope,
    allowed_space_ids,
):
    if not _decision(
        user,
        "FINANZAS_CONSULTAR",
        property_id,
    ).allowed:
        _denied("FINANZAS_CONSULTAR")
        return

    if scope["kind"] == "ALL":
        summary = financial_summary(
            property_id,
            user["id"],
            period or None,
        )

        metrics(
            [
                (
                    "Cargos",
                    money(summary["charges"]),
                ),
                (
                    "Pagos",
                    money(summary["payments"]),
                ),
                (
                    "Pendiente",
                    money(summary["pending"]),
                ),
                (
                    "Gastos",
                    money(summary["expenses"]),
                ),
                (
                    "Disponible",
                    money(
                        summary[
                            "available_balance"
                        ]
                    ),
                ),
            ]
        )

    else:
        scoped_charges = _rows_in_scope(
            list_charges(
                property_id,
                user["id"],
                period=period or None,
            ),
            allowed_space_ids,
        )

        scoped_payments = _rows_in_scope(
            list_payments(
                property_id,
                user["id"],
                period=period or None,
            ),
            allowed_space_ids,
        )

        total_charges = sum(
            Decimal(
                str(row.get("monto_mxn") or 0)
            )
            for row in scoped_charges
        )

        total_payments = sum(
            Decimal(
                str(row.get("monto_mxn") or 0)
            )
            for row in scoped_payments
        )

        metrics(
            [
                (
                    "Cargos",
                    money(total_charges),
                ),
                (
                    "Pagos",
                    money(total_payments),
                ),
                (
                    "Pendiente",
                    money(
                        max(
                            total_charges
                            - total_payments,
                            Decimal("0"),
                        )
                    ),
                ),
            ]
        )

        st.info(
            "Los gastos y el disponible no se "
            "calculan para esta estructura porque "
            "los gastos actuales pertenecen al "
            "ámbito general del inmueble."
        )

    st.caption(
        "Resumen transaccional. No representa todavía un KPI de sostenibilidad financiera."
    )


def _charges_section(
    property_id,
    user,
    period,
    spaces,
    allowed_space_ids,
):
    can_read = _decision(
        user,
        "FINANZAS_CONSULTAR",
        property_id,
    ).allowed

    if not can_read:
        _denied("FINANZAS_CONSULTAR")
        return

    st.subheader("Cargos")

    include_cancelled = st.checkbox(
        "Mostrar cargos cancelados",
        key=f"finance_charge_cancelled_{property_id}",
    )

    rows = list_charges(
        property_id,
        user["id"],
        period=period or None,
        include_cancelled=include_cancelled,
    )

    rows = _rows_in_scope(
        rows,
        allowed_space_ids,
    )

    display = pd.DataFrame(
        [
            {
                "ID": row["id"],
                "Periodo": row.get("periodo"),
                "Espacio": (
                    f"{row.get('espacio_clave') or ''} "
                    f"{row.get('espacio_nombre') or ''}"
                ).strip(),
                "Tipo": row.get("tipo_codigo"),
                "Concepto": row.get("concepto"),
                "Monto": money(
                    row.get("monto_mxn")
                ),
                "Estado": row.get("estado_codigo"),
                "Referencia": (
                    row.get("referencia") or ""
                ),
            }
            for row in rows
        ]
    )

    selected = None

    if display.empty:
        st.info(
            "No existen cargos para los filtros "
            "seleccionados."
        )
    else:
        event = st.dataframe(
            display,
            hide_index=True,
            use_container_width=True,
            column_config={"ID": None},
            on_select="rerun",
            selection_mode="single-row",
            key=f"finance_charge_grid_{property_id}",
        )

        indexes = list(
            event.selection.rows or []
        )

        if indexes:
            index = indexes[0]

            if 0 <= index < len(rows):
                selected = rows[index]

    can_create = _decision(
        user,
        "FINANZAS_CARGO_CREAR",
        property_id,
    ).allowed

    if can_create:
        with st.expander(
            "Registrar nuevo cargo",
            expanded=False,
        ):
            if not spaces:
                st.info(
                    "No existen espacios activos "
                    "para registrar cargos."
                )
            else:
                charge_types = options(
                    "TIPO_CARGO"
                )

                if not charge_types:
                    st.error(
                        "No está disponible el "
                        "catálogo TIPO_CARGO."
                    )
                else:
                    with st.form(
                        f"finance_charge_create_{property_id}"
                    ):
                        labels = list(spaces)
                        space_label = st.selectbox(
                            "Espacio",
                            labels,
                        )

                        period_value = st.text_input(
                            "Periodo",
                            value=(
                                period
                                or _period_default()
                            ),
                            placeholder="AAAA-MM",
                        )

                        type_label = st.selectbox(
                            "Tipo de cargo",
                            list(charge_types),
                        )

                        concept = st.text_input(
                            "Concepto"
                        )

                        amount = st.number_input(
                            "Monto",
                            min_value=0.01,
                            step=100.0,
                            format="%.2f",
                        )

                        reference = st.text_input(
                            "Referencia"
                        )

                        observations = st.text_area(
                            "Observaciones"
                        )

                        submit = (
                            st.form_submit_button(
                                "Registrar Cargo",
                                type="primary",
                            )
                        )

                    if submit:
                        try:
                            space = spaces[
                                space_label
                            ]

                            create_charge(
                                property_id=property_id,
                                space_id=space["id"],
                                period=period_value,
                                charge_type=(
                                    charge_types[
                                        type_label
                                    ]
                                ),
                                concept=concept,
                                amount=amount,
                                actor_id=user["id"],
                                reference=reference,
                                observations=observations,
                            )

                            st.success(
                                "Cargo registrado "
                                "correctamente."
                            )
                            st.rerun()

                        except Exception as exc:
                            st.error(
                                "No fue posible registrar "
                                f"el cargo: {exc}"
                            )

    if (
        selected
        and selected.get("estado_codigo")
        == "REGISTRADO"
    ):
        _cancellation_section(
            property_id,
            user,
            "CARGO",
            selected,
        )


