import streamlit as st
from core.db import execute
from core.auth import audit
from core.authorization import require
from components.ui import title,table,property_header
from services.catalogs import options
from services.media import validate
from services.properties import list_properties,dependencies,deletable
from services.property_admins import list_admins,create_admin,revoke,reactivate,reset_password
def form(row=None,key='p'):
 row=row or {};types=options('TIPO_INMUEBLE');rev={v:k for k,v in types.items()};a,b=st.columns(2);clave=a.text_input('Clave',row.get('clave',''),key=key+'c');name=b.text_input('Nombre',row.get('nombre',''),key=key+'n');a,b=st.columns(2);disp=rev.get(row.get('tipo_codigo'),list(types)[0]);typ=a.selectbox('Tipo De Inmueble',list(types),index=list(types).index(disp),key=key+'t');currency=b.selectbox('Moneda Base',['MXN','USD','EUR','CAD'],index=['MXN','USD','EUR','CAD'].index(row.get('moneda_base') or 'MXN'),key=key+'m');address=st.text_area('Dirección',row.get('direccion') or '',key=key+'d');a,b=st.columns(2);rfc=a.text_input('RFC',row.get('rfc') or '',key=key+'r');tz=b.text_input('Zona Horaria',row.get('zona_horaria') or 'America/Mexico_City',key=key+'z');return {'clave':clave.upper().strip(),'nombre':name.strip(),'tipo_codigo':types[typ],'moneda_base':currency,'direccion':address,'rfc':rfc,'zona_horaria':tz}
def render():
 user=st.session_state.user;title('Inmuebles','Datos Generales, Administradores, Identidad Y Estado');rows=list_properties();friendly=[]
 for x in rows:friendly.append({**x,'tipo_codigo':next((k for k,v in options('TIPO_INMUEBLE').items() if v==x['tipo_codigo']),x['tipo_codigo'])})
 table(friendly,'condominios',['clave','nombre','tipo_codigo','moneda_base','direccion','rfc','zona_horaria','activo']);labels={f"{x['clave']} - {x['nombre']}":x for x in rows};tabs=st.tabs(['Alta','Datos Generales','Administradores','Identidad','Estado','Eliminar'])
 with tabs[0]:
  require(user,'INMUEBLE_CREAR')
  with st.form('new'):v=form(key='n');ok=st.form_submit_button('Crear Inmueble',type='primary')
  if ok:
   if not v['clave'] or not v['nombre']:st.error('Clave Y Nombre Son Obligatorios')
   else:r=execute('INSERT INTO condominios(clave,nombre,tipo_codigo,direccion,rfc,moneda_base,zona_horaria) VALUES(%s,%s,%s,%s,%s,%s,%s) RETURNING id',tuple(v.values()),True);audit('INMUEBLE_CREAR','condominios',r['id'],after=v);st.rerun()
 if labels:
  with tabs[1]:
   selected=st.selectbox('Inmueble',list(labels),key='gen');row=labels[selected];property_header(row);require(user,'INMUEBLE_MODIFICAR',row['id'])
   with st.form('edit'):v=form(row,'e');ok=st.form_submit_button('Guardar Cambios',type='primary')
   if ok:execute('UPDATE condominios SET clave=%s,nombre=%s,tipo_codigo=%s,moneda_base=%s,direccion=%s,rfc=%s,zona_horaria=%s,actualizado_en=NOW() WHERE id=%s',(v['clave'],v['nombre'],v['tipo_codigo'],v['moneda_base'],v['direccion'],v['rfc'],v['zona_horaria'],row['id']));audit('INMUEBLE_MODIFICAR','condominios',row['id'],before=row,after=v);st.rerun()
  with tabs[2]:
   selected=st.selectbox('Inmueble',list(labels),key='admins');row=labels[selected];require(user,'ADMINISTRADOR_ASIGNAR',row['id']);admins=list_admins(row['id']);table(admins,'usuarios',['username','nombre','email','rol_codigo','activo','asignacion_activa'])
   with st.expander('Nuevo Administrador'):
    with st.form('newadmin'):name=st.text_input('Nombre');email=st.text_input('Correo Electrónico');username=st.text_input('Usuario');password=st.text_input('Contraseña Inicial',type='password');ok=st.form_submit_button('Crear Y Asignar')
    if ok:u=create_admin(row['id'],name,email,username,password,user['id']);audit('ADMINISTRADOR_CREAR','usuarios',u['id'],after={'condominio_id':row['id']});st.rerun()
   if admins:
    amap={f"{x['username']} - {x['nombre']}":x for x in admins};asel=st.selectbox('Administrar Acceso',list(amap));a=amap[asel];c1,c2,c3=st.columns(3)
    if c1.button('Revocar Del Inmueble'):revoke(row['id'],a['id'],user['id']);audit('ADMINISTRADOR_REVOCAR','usuarios',a['id']);st.rerun()
    if c2.button('Reactivar Asignación'):reactivate(row['id'],a['id'],user['id']);audit('ADMINISTRADOR_REACTIVAR','usuarios',a['id']);st.rerun()
    newpw=c3.text_input('Nueva Contraseña',type='password',key='rpw')
    if c3.button('Restablecer') and newpw:reset_password(a['id'],newpw);audit('ADMINISTRADOR_PASSWORD_RESET','usuarios',a['id']);st.rerun()
  with tabs[3]:
   selected=st.selectbox('Inmueble',list(labels),key='brand');row=labels[selected];property_header(row);require(user,'INMUEBLE_BRANDING',row['id'])
   with st.form('branding'):logo=st.file_uploader('Nuevo Logotipo',type=['jpg','jpeg','png','bmp']);cover=st.file_uploader('Nueva Portada',type=['jpg','jpeg','png','bmp']);ok=st.form_submit_button('Guardar Identidad')
   if ok:
    l=validate(logo,2) if logo else None;p=validate(cover,5) if cover else None;execute('UPDATE condominios SET logo_data=COALESCE(%s,logo_data),logo_mime=COALESCE(%s,logo_mime),portada_data=COALESCE(%s,portada_data),portada_mime=COALESCE(%s,portada_mime) WHERE id=%s',(l['data'] if l else None,l['mime'] if l else None,p['data'] if p else None,p['mime'] if p else None,row['id']));audit('INMUEBLE_BRANDING','condominios',row['id']);st.rerun()
  with tabs[4]:
   selected=st.selectbox('Inmueble',list(labels),key='state');row=labels[selected];perm='INMUEBLE_DESACTIVAR' if row['activo'] else 'INMUEBLE_REACTIVAR';require(user,perm,row['id']);action='Desactivar' if row['activo'] else 'Reactivar';confirm=st.checkbox('Confirmo '+action)
   if st.button(action,disabled=not confirm):execute('UPDATE condominios SET activo=NOT activo WHERE id=%s',(row['id'],));audit(perm,'condominios',row['id']);st.rerun()
  with tabs[5]:
   selected=st.selectbox('Inmueble',list(labels),key='delete');row=labels[selected];require(user,'INMUEBLE_ELIMINAR',row['id']);deps=dependencies(row['id']);st.write('Dependencias',deps)
   if deletable(row['id']):
    confirm=st.checkbox('Confirmo La Eliminación Permanente')
    if st.button('Eliminar Inmueble',disabled=not confirm):audit('INMUEBLE_ELIMINAR','condominios',row['id'],before=row);execute('DELETE FROM condominios WHERE id=%s',(row['id'],));st.rerun()
   else:st.warning('Este Inmueble Tiene Registros Relacionados. Utiliza Desactivar.')
