def _actor(actor_id):
    row = fetch_one(
        """
        SELECT
            id,
            username,
            nombre,
            email,
            rol_global,
            activo
        FROM usuarios
        WHERE id=%s
        """,
        (actor_id,),
    )

    if not row or not row.get("activo"):
        raise PermissionError(
            "USER_INACTIVE"
        )

    return dict(row)


def _require_actor(
    actor_id,
    permission,
    property_id,
):
    actor = _actor(actor_id)

    require(
        actor,
        permission,
        property_id,
    )

    return actor


def _required_text(
    value,
    error_code,
    max_length=None,
):
    text = str(value or "").strip()

    if not text:
        raise ValueError(error_code)

    if (
        max_length is not None
        and len(text) > max_length
    ):
        raise ValueError(
            error_code + "_TOO_LONG"
        )

    return text


def _optional_text(
    value,
    max_length=None,
):
    if value is None:
        return None

    text = str(value).strip()

    if not text:
        return None

    if (
        max_length is not None
        and len(text) > max_length
    ):
        raise ValueError(
            "FINANCIAL_GOVERNANCE_TEXT_TOO_LONG"
        )

    return text


def _valid_dates(
    effective_from,
    effective_to,
):
    if not isinstance(
        effective_from,
        date,
    ):
        raise ValueError(
            "INVALID_EFFECTIVE_FROM"
        )

    if (
        effective_to is not None
        and not isinstance(
            effective_to,
            date,
        )
    ):
        raise ValueError(
            "INVALID_EFFECTIVE_TO"
        )

    if (
        effective_to is not None
        and effective_to < effective_from
    ):
        raise ValueError(
            "INVALID_EFFECTIVE_DATE_RANGE"
        )

    return (
        effective_from,
        effective_to,
    )


def _json(value):
    if value is None:
        value = {}

    return json.dumps(
        sanitize(value),
        default=str,
        ensure_ascii=False,
    )


def _insert_audit(
    cursor,
    *,
    actor,
    property_id,
    operation_type,
    entity,
    entity_id,
    previous_status=None,
    new_status=None,
    detail=None,
    metadata=None,
    trace_id=None,
):
    trace_id = (
        trace_id
        or new_trace_id()
    )

    cursor.execute(
        """
        INSERT INTO auditoria_financiera(
            condominio_id,
            usuario_id,
            username,
            tipo_operacion,
            entidad,
            entidad_id,
            estado_anterior,
            estado_nuevo,
            detalle,
            metadata,
            trace_id
        )
        VALUES(
            %s,%s,%s,%s,%s,%s,
            %s,%s,%s,%s::jsonb,%s
        )
        RETURNING id
        """,
        (
            property_id,
            actor["id"],
            actor.get("username"),
            operation_type,
            entity,
            entity_id,
            previous_status,
            new_status,
            detail,
            _json(metadata),
            trace_id,
        ),
    )

    return cursor.fetchone()


def create_financial_objective(
    *,
    property_id,
    code,
    name,
    effective_from,
    actor_id,
    structure_id=None,
    description=None,
    objective_type=None,
    parameters=None,
    effective_to=None,
    priority=100,
    change_reason=None,
):
    actor = _require_actor(
        actor_id,
        "FINANZAS_OBJETIVO_GESTIONAR",
        property_id,
    )

    code = _required_text(
        code,
        "FINANCIAL_OBJECTIVE_CODE_REQUIRED",
        80,
    ).upper()

    name = _required_text(
        name,
        "FINANCIAL_OBJECTIVE_NAME_REQUIRED",
        200,
    )

    description = _optional_text(
        description,
    )

    objective_type = _optional_text(
        objective_type,
        80,
    )

    change_reason = _optional_text(
        change_reason,
    )

    effective_from, effective_to = (
        _valid_dates(
            effective_from,
            effective_to,
        )
    )

    priority = int(priority)

    if priority < 0:
        raise ValueError(
            "INVALID_FINANCIAL_OBJECTIVE_PRIORITY"
        )

    trace_id = new_trace_id()

    with pool().connection() as connection:
        try:
            with connection.cursor() as cursor:
                cursor.execute(
                    """
                    INSERT INTO financial_objectives(
                        condominio_id,
                        estructura_id,
                        codigo,
                        nombre,
                        descripcion,
                        tipo_objetivo,
                        parametros,
                        vigente_desde,
                        vigente_hasta,
                        estado_codigo,
                        prioridad,
                        creado_por,
                        motivo_cambio
                    )
                    VALUES(
                        %s,%s,%s,%s,%s,%s,
                        %s::jsonb,%s,%s,
                        'BORRADOR',%s,%s,%s
                    )
                    RETURNING *
                    """,
                    (
                        property_id,
                        structure_id,
                        code,
                        name,
                        description,
                        objective_type,
                        _json(parameters),
                        effective_from,
                        effective_to,
                        priority,
                        actor["id"],
                        change_reason,
                    ),
                )

                objective = dict(
                    cursor.fetchone()
                )

                audit = _insert_audit(
                    cursor,
                    actor=actor,
                    property_id=property_id,
                    operation_type=(
                        "FINANCIAL_OBJECTIVE_CREATED"
                    ),
                    entity=(
                        "FINANCIAL_OBJECTIVE"
                    ),
                    entity_id=objective["id"],
                    previous_status=None,
                    new_status="BORRADOR",
                    detail=name,
                    metadata={
                        "codigo": code,
                        "estructura_id": (
                            structure_id
                        ),
                        "vigente_desde": (
                            effective_from
                        ),
                        "vigente_hasta": (
                            effective_to
                        ),
                        "prioridad": priority,
                    },
                    trace_id=trace_id,
                )

            connection.commit()

        except Exception:
            connection.rollback()
            raise

    objective["audit_event_id"] = (
        audit["id"]
    )
    objective["trace_id"] = trace_id

    return objective


def approve_financial_objective(
    *,
    property_id,
    objective_id,
    actor_id,
    approval_reason,
):
