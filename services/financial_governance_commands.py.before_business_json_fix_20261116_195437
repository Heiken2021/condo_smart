                        estado_codigo='APROBADO',
                        aprobado_por=%s,
                        aprobado_en=NOW(),
                        motivo_cambio=%s
                    WHERE id=%s
                      AND condominio_id=%s
                    RETURNING *
                    """,
                    (
                        actor["id"],
                        approval_reason,
                        objective_id,
                        property_id,
                    ),
                )

                objective = dict(
                    cursor.fetchone()
                )

                audit = _insert_audit(
                    cursor,
                    actor=actor,
                    property_id=property_id,
                    operation_type=(
                        "FINANCIAL_OBJECTIVE_APPROVED"
                    ),
                    entity=(
                        "FINANCIAL_OBJECTIVE"
                    ),
                    entity_id=objective_id,
                    previous_status="BORRADOR",
                    new_status="APROBADO",
                    detail=approval_reason,
                    metadata={
                        "codigo": objective[
                            "codigo"
                        ],
                        "estructura_id": (
                            objective.get(
                                "estructura_id"
                            )
                        ),
                    },
                    trace_id=trace_id,
                )

            connection.commit()

        except Exception:
            connection.rollback()
            raise

    objective["audit_event_id"] = (
        audit["id"]
    )
    objective["trace_id"] = trace_id

    return objective


