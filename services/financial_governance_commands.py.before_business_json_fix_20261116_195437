def create_financial_rule(
    *,
    property_id,
    definition_id,
    scope_level,
    code,
    name,
    actor_id,
    policy_id=None,
    structure_id=None,
    space_id=None,
    applicable_type=None,
    description=None,
    inherits=True,
    is_override=False,
    priority=100,
):
    actor = _require_actor(
        actor_id,
        "FINANZAS_REGLA_GESTIONAR",
        property_id,
    )

    scope_level = _required_text(
        scope_level,
        "FINANCIAL_RULE_SCOPE_REQUIRED",
        30,
    ).upper()

    if scope_level not in {
        "INMUEBLE",
        "ESTRUCTURA",
        "ESPACIO",
    }:
        raise ValueError(
            "INVALID_PROPERTY_FINANCIAL_RULE_SCOPE"
        )

    code = _required_text(
        code,
        "FINANCIAL_RULE_CODE_REQUIRED",
        100,
    ).upper()

    name = _required_text(
        name,
        "FINANCIAL_RULE_NAME_REQUIRED",
        200,
    )

    priority = int(priority)

    if priority < 0:
        raise ValueError(
            "INVALID_FINANCIAL_RULE_PRIORITY"
        )

    if (
        scope_level == "INMUEBLE"
        and (
            structure_id is not None
            or space_id is not None
        )
    ):
        raise ValueError(
            "INVALID_PROPERTY_RULE_SCOPE"
        )

    if (
        scope_level == "ESTRUCTURA"
        and (
            structure_id is None
            or space_id is not None
        )
    ):
        raise ValueError(
            "INVALID_STRUCTURE_RULE_SCOPE"
        )

    if (
        scope_level == "ESPACIO"
        and space_id is None
    ):
        raise ValueError(
            "INVALID_SPACE_RULE_SCOPE"
        )

    trace_id = new_trace_id()

    with pool().connection() as connection:
        try:
            with connection.cursor() as cursor:
                cursor.execute(
                    """
                    SELECT
                        id,
                        codigo,
                        activo
                    FROM financial_rule_definitions
                    WHERE id=%s
                      AND activo=TRUE
                    """,
                    (definition_id,),
                )

                definition = cursor.fetchone()

                if not definition:
                    raise ValueError(
                        "FINANCIAL_RULE_DEFINITION_NOT_FOUND"
                    )

                if policy_id is not None:
                    cursor.execute(
                        """
                        SELECT
                            id,
                            condominio_id,
                            estado_codigo
                        FROM financial_policies
                        WHERE id=%s
                          AND condominio_id=%s
                        """,
                        (
                            policy_id,
                            property_id,
                        ),
                    )

                    policy = cursor.fetchone()

                    if not policy:
                        raise ValueError(
                            "FINANCIAL_POLICY_NOT_FOUND"
                        )

                    if (
                        policy["estado_codigo"]
                        != "APROBADO"
                    ):
                        raise ValueError(
                            "FINANCIAL_RULE_REQUIRES_APPROVED_POLICY"
                        )

                cursor.execute(
                    """
                    INSERT INTO financial_rules(
                        rule_definition_id,
                        policy_id,
                        scope_level,
                        condominio_id,
                        estructura_id,
                        espacio_id,
                        tipo_aplicable_codigo,
                        codigo,
                        nombre,
                        descripcion,
                        hereda,
                        es_override,
                        prioridad,
                        activo,
                        creado_por
                    )
                    VALUES(
                        %s,%s,%s,%s,%s,%s,%s,
                        %s,%s,%s,%s,%s,%s,TRUE,%s
                    )
                    RETURNING *
                    """,
                    (
                        definition_id,
                        policy_id,
                        scope_level,
                        property_id,
                        structure_id,
                        space_id,
                        applicable_type,
                        code,
                        name,
                        _optional_text(description),
                        bool(inherits),
                        bool(is_override),
                        priority,
                        actor["id"],
                    ),
                )

                rule = dict(cursor.fetchone())

                audit = _insert_audit(
                    cursor,
                    actor=actor,
                    property_id=property_id,
                    operation_type=(
                        "FINANCIAL_RULE_CREATED"
                    ),
                    entity="FINANCIAL_RULE",
                    entity_id=rule["id"],
                    new_status="ACTIVO",
                    detail=name,
                    metadata={
                        "definition_id": definition_id,
                        "policy_id": policy_id,
                        "scope_level": scope_level,
                        "estructura_id": structure_id,
                        "espacio_id": space_id,
                        "es_override": bool(
                            is_override
                        ),
                        "prioridad": priority,
                    },
                    trace_id=trace_id,
                )

            connection.commit()

        except Exception:
            connection.rollback()
            raise

    rule["audit_event_id"] = audit["id"]
    rule["trace_id"] = trace_id

    return rule



def _validate_rule_parameters(
    cursor,
    *,
    definition_id,
    parameters,
):
    if not isinstance(parameters, dict):
        raise ValueError(
            "FINANCIAL_RULE_PARAMETERS_REQUIRED"
        )

    cursor.execute(
        """
        SELECT
            codigo,
            esquema_parametros
        FROM financial_rule_definitions
        WHERE id=%s
          AND activo=TRUE
        """,
        (definition_id,),
    )

    definition = cursor.fetchone()

    if not definition:
        raise ValueError(
            "FINANCIAL_RULE_DEFINITION_NOT_FOUND"
        )

    schema = (
        definition["esquema_parametros"]
        or {}
    )

    unknown = (
        set(parameters)
        - set(schema)
    )

    if unknown:
        raise ValueError(
            "UNKNOWN_FINANCIAL_RULE_PARAMETERS:"
            + ",".join(sorted(unknown))
        )

    validated = {}

    for code, specification in schema.items():
        specification = (
            specification
            if isinstance(
                specification,
                dict,
            )
            else {}
        )

        optional = bool(
            specification.get(
                "optional",
                False,
            )
        )

        value = parameters.get(code)

        if value is None:
            if optional:
                continue

            raise ValueError(
                "FINANCIAL_RULE_PARAMETER_REQUIRED:"
                + code
            )

        parameter_type = (
            specification.get("type")
        )

        if parameter_type == "number":
            if (
                isinstance(value, bool)
                or not isinstance(
                    value,
                    (int, float),
                )
            ):
                raise ValueError(
                    "INVALID_NUMBER_PARAMETER:"
                    + code
                )

            value = float(value)

        elif parameter_type == "integer":
            if (
                isinstance(value, bool)
                or not isinstance(value, int)
            ):
                raise ValueError(
                    "INVALID_INTEGER_PARAMETER:"
                    + code
                )

        elif parameter_type == "boolean":
            if not isinstance(value, bool):
                raise ValueError(
                    "INVALID_BOOLEAN_PARAMETER:"
                    + code
                )

        elif parameter_type == "string":
            if not isinstance(value, str):
                raise ValueError(
                    "INVALID_STRING_PARAMETER:"
                    + code
                )

        minimum = specification.get(
            "minimum"
        )

        maximum = specification.get(
            "maximum"
        )

        if (
            minimum is not None
            and value < minimum
        ):
            raise ValueError(
                "FINANCIAL_RULE_PARAMETER_BELOW_MINIMUM:"
                + code
            )

        if (
            maximum is not None
            and value > maximum
        ):
            raise ValueError(
                "FINANCIAL_RULE_PARAMETER_ABOVE_MAXIMUM:"
                + code
            )

        allowed = (
            specification.get("allowed")
            or []
        )

        if (
            allowed
            and value not in allowed
        ):
            raise ValueError(
                "FINANCIAL_RULE_PARAMETER_NOT_ALLOWED:"
                + code
            )

        validated[code] = value

    return validated


def create_rule_version(
    *,
    property_id,
    rule_id,
    version_num,
    effective_from,
    parameters,
    actor_id,
    effective_to=None,
    change_reason=None,
):
    actor = _require_actor(
        actor_id,
        "FINANZAS_REGLA_GESTIONAR",
        property_id,
    )

    effective_from, effective_to = _valid_dates(
        effective_from,
        effective_to,
    )

    version_num = int(version_num)

    if version_num <= 0:
        raise ValueError(
            "INVALID_FINANCIAL_RULE_VERSION"
        )

    trace_id = new_trace_id()

    with pool().connection() as connection:
        try:
            with connection.cursor() as cursor:
                cursor.execute(
                    """
                    SELECT
                        id,
                        codigo,
                        condominio_id,
                        rule_definition_id,
                        activo
