def request_financial_exception(
    *,
    property_id,
    rule_version_id,
    reason,
    actor_id,
    structure_id=None,
    space_id=None,
    exception_type=None,
    parameters=None,
    effective_from=None,
    effective_to=None,
):
    actor = _require_actor(
        actor_id,
        "FINANZAS_EXCEPCION_SOLICITAR",
        property_id,
    )

    reason = _required_text(
        reason,
        "FINANCIAL_EXCEPTION_REASON_REQUIRED",
    )

    exception_type = _optional_text(
        exception_type,
        80,
    )

    if (
        effective_from is not None
        or effective_to is not None
    ):
        if effective_from is None:
            raise ValueError(
                "INVALID_EFFECTIVE_FROM"
            )

        effective_from, effective_to = _valid_dates(
            effective_from,
            effective_to,
        )

    trace_id = new_trace_id()

    with pool().connection() as connection:
        try:
            with connection.cursor() as cursor:
                cursor.execute(
                    """
                    SELECT
                        version.id,
                        version.estado_codigo,
                        version.vigente_desde,
                        version.vigente_hasta,
                        rule.condominio_id,
                        rule.estructura_id,
                        rule.espacio_id,
                        definition.admite_excepcion
                    FROM financial_rule_versions version
                    JOIN financial_rules rule
                      ON rule.id=version.rule_id
                    JOIN financial_rule_definitions definition
                      ON definition.id=
                         rule.rule_definition_id
                    WHERE version.id=%s
                    """,
                    (rule_version_id,),
                )

                rule_version = cursor.fetchone()

                if not rule_version:
                    raise ValueError(
                        "FINANCIAL_RULE_VERSION_NOT_FOUND"
                    )

                if (
                    rule_version["estado_codigo"]
                    != "APROBADO"
                ):
                    raise ValueError(
                        "FINANCIAL_EXCEPTION_REQUIRES_APPROVED_RULE"
                    )

                if not rule_version[
                    "admite_excepcion"
                ]:
                    raise ValueError(
                        "FINANCIAL_RULE_EXCEPTION_NOT_ALLOWED"
                    )

                if (
                    rule_version.get("condominio_id")
                    is not None
                    and rule_version["condominio_id"]
                    != property_id
                ):
                    raise ValueError(
                        "FINANCIAL_EXCEPTION_RULE_SCOPE_MISMATCH"
                    )

                cursor.execute(
                    """
                    INSERT INTO financial_rule_exceptions(
                        condominio_id,
                        estructura_id,
                        espacio_id,
                        rule_version_id,
                        tipo_excepcion,
                        parametros,
                        motivo,
                        estado_codigo,
                        vigente_desde,
                        vigente_hasta,
                        solicitado_por
                    )
                    VALUES(
                        %s,%s,%s,%s,%s,
                        %s::jsonb,%s,'PENDIENTE',
                        %s,%s,%s
                    )
                    RETURNING *
                    """,
                    (
                        property_id,
                        structure_id,
                        space_id,
                        rule_version_id,
                        exception_type,
                        _json(parameters),
                        reason,
                        effective_from,
                        effective_to,
                        actor["id"],
                    ),
                )

                exception = dict(
                    cursor.fetchone()
                )

                audit = _insert_audit(
                    cursor,
                    actor=actor,
                    property_id=property_id,
                    operation_type=(
                        "FINANCIAL_EXCEPTION_REQUESTED"
                    ),
                    entity=(
                        "FINANCIAL_RULE_EXCEPTION"
                    ),
                    entity_id=exception["id"],
                    previous_status=None,
                    new_status="PENDIENTE",
                    detail=reason,
                    metadata={
                        "rule_version_id": (
                            rule_version_id
                        ),
                        "estructura_id": (
                            structure_id
                        ),
                        "espacio_id": space_id,
                        "tipo_excepcion": (
                            exception_type
                        ),
                        "vigente_desde": (
                            effective_from
                        ),
                        "vigente_hasta": (
                            effective_to
                        ),
                    },
                    trace_id=trace_id,
                )

            connection.commit()

        except Exception:
            connection.rollback()
            raise

    exception["audit_event_id"] = (
        audit["id"]
    )
    exception["trace_id"] = trace_id

    return exception


def resolve_financial_exception(
    *,
    property_id,
    exception_id,
    decision,
    decision_detail,
    actor_id,
):
    actor = _require_actor(
        actor_id,
        "FINANZAS_EXCEPCION_RESOLVER",
        property_id,
    )

    decision = _required_text(
        decision,
        "FINANCIAL_EXCEPTION_DECISION_REQUIRED",
        30,
    ).upper()

    if decision not in {
        "APROBADA",
        "RECHAZADA",
    }:
        raise ValueError(
            "INVALID_FINANCIAL_EXCEPTION_DECISION"
        )

    decision_detail = _required_text(
        decision_detail,
        "FINANCIAL_EXCEPTION_DECISION_DETAIL_REQUIRED",
    )

    trace_id = new_trace_id()

    with pool().connection() as connection:
        try:
            with connection.cursor() as cursor:
                cursor.execute(
                    """
                    SELECT *
                    FROM financial_rule_exceptions
                    WHERE id=%s
                      AND condominio_id=%s
                    FOR UPDATE
                    """,
                    (
                        exception_id,
                        property_id,
                    ),
                )

                current = cursor.fetchone()

                if not current:
                    raise ValueError(
                        "FINANCIAL_EXCEPTION_NOT_FOUND"
                    )

                current = dict(current)

                if (
                    current["estado_codigo"]
                    != "PENDIENTE"
                ):
                    raise ValueError(
                        "FINANCIAL_EXCEPTION_NOT_RESOLVABLE"
                    )

                cursor.execute(
                    """
                    UPDATE financial_rule_exceptions
                    SET
                        estado_codigo=%s,
                        resuelto_por=%s,
                        resuelto_en=NOW(),
                        decision_detalle=%s
                    WHERE id=%s
                      AND condominio_id=%s
                    RETURNING *
                    """,
                    (
                        decision,
                        actor["id"],
                        decision_detail,
                        exception_id,
                        property_id,
                    ),
                )

                exception = dict(
                    cursor.fetchone()
                )

                audit = _insert_audit(
                    cursor,
                    actor=actor,
                    property_id=property_id,
                    operation_type=(
                        "FINANCIAL_EXCEPTION_RESOLVED"
                    ),
                    entity=(
                        "FINANCIAL_RULE_EXCEPTION"
                    ),
                    entity_id=exception_id,
                    previous_status="PENDIENTE",
                    new_status=decision,
                    detail=decision_detail,
                    metadata={
                        "rule_version_id": (
                            exception[
                                "rule_version_id"
                            ]
                        ),
                        "estructura_id": (
                            exception.get(
                                "estructura_id"
                            )
                        ),
                        "espacio_id": (
                            exception.get(
                                "espacio_id"
                            )
                        ),
                        "decision": decision,
                    },
                    trace_id=trace_id,
                )

            connection.commit()

        except Exception:
            connection.rollback()
            raise

    exception["audit_event_id"] = (
        audit["id"]
    )
    exception["trace_id"] = trace_id

    return exception
