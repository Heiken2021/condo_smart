PARAMETER_LABELS = {
    "amount": "Importe",
    "frequency": "Frecuencia",
    "due_day": "Día de vencimiento",
}

TYPE_LABELS = {
    "number": "Monetario",
    "integer": "Número entero",
    "string": "Selección",
    "boolean": "Sí / No",
}

VALUE_LABELS = {
    "MENSUAL": "Mensual",
    "SEMANAL": "Semanal",
    "QUINCENAL": "Quincenal",
    "ANUAL": "Anual",
}

STATUS_LABELS = {
    "SIN_CONFIGURAR": "Sin configurar",
    "SIN_VERSION": "Sin versión",
    "BORRADOR": "Borrador",
    "APROBADO": "Aprobado",
    "VIGENTE": "Vigente",
    "CERRADO": "Finalizado",
    "RECHAZADO": "Rechazado",
    "PENDIENTE": "Pendiente",
}

SCOPE_LABELS = {
    "CORE": "Base del sistema",
    "INMUEBLE": "Todo el inmueble",
    "ESTRUCTURA": "Estructura",
    "ESPACIO": "Espacio",
}


def business_status(value):
    return STATUS_LABELS.get(
        value,
        str(value or "Sin estado"),
    )


def business_scope(value):
    return SCOPE_LABELS.get(
        value,
        str(value or "Base del sistema"),
    )


def business_value(value):
    if value is None:
        return "—"

    if isinstance(value, bool):
        return "Sí" if value else "No"

    if isinstance(value, list):
        return ", ".join(
            business_value(item)
            for item in value
        )

    return VALUE_LABELS.get(
        str(value),
        str(value),
    )


def _numeric_condition(
    specification,
    *,
    currency=None,
):
    conditions = []

    minimum = specification.get(
        "minimum"
    )

    maximum = specification.get(
        "maximum"
    )

    if minimum is not None:
        if currency:
            conditions.append(
                f"Mínimo ${float(minimum):,.2f} "
                f"{currency}"
            )
        else:
            conditions.append(
                f"Mínimo {minimum}"
            )

    if maximum is not None:
        conditions.append(
            f"Máximo {maximum}"
        )

    if not conditions:
        return "Sin límites definidos"

    return " · ".join(conditions)


def parameter_schema_rows(schema):
    if not isinstance(schema, dict):
        return []

    rows = []

    ordered_keys = [
        key
        for key in PARAMETER_LABELS
        if key in schema
    ]

    ordered_keys.extend(
        sorted(
            key
            for key in schema
            if key not in ordered_keys
        )
    )

    for key in ordered_keys:
        specification = (
            schema.get(key) or {}
        )

        if not isinstance(
            specification,
            dict,
        ):
            specification = {
                "default": specification,
            }

        type_code = specification.get(
            "type",
            "string",
        )

        currency = specification.get(
            "currency"
        )

        allowed = specification.get(
            "allowed"
        ) or []

        optional = bool(
            specification.get(
                "optional",
                False,
            )
        )

        if allowed:
            condition = (
                "Valores permitidos: "
                + ", ".join(
                    business_value(value)
                    for value in allowed
                )
            )
        elif type_code in {
            "number",
            "integer",
        }:
            condition = _numeric_condition(
                specification,
                currency=currency,
            )
        else:
            condition = (
                "Sin restricciones adicionales"
            )

        rows.append(
            {
                "Código": key,
                "Parámetro": (
                    PARAMETER_LABELS.get(
                        key,
                        key.replace(
                            "_",
                            " ",
                        ).title(),
                    )
                ),
                "Tipo": (
                    TYPE_LABELS.get(
                        type_code,
                        type_code,
                    )
                ),
                "Condición": condition,
                "Obligatorio": (
                    "No" if optional else "Sí"
                ),
                "Unidad": (
                    currency or "—"
                ),
                "Valor predeterminado": (
                    business_value(
                        specification.get(
                            "default"
                        )
                    )
                ),
            }
        )

    return rows


def configured_parameter_rows(
    schema,
    values,
):
    definitions = (
        parameter_schema_rows(schema)
    )

    values = (
        values
        if isinstance(values, dict)
        else {}
    )

    result = []

    for definition in definitions:
        code = definition["Código"]

        result.append(
            {
                "Parámetro": (
                    definition["Parámetro"]
                ),
                "Valor configurado": (
                    business_value(
                        values.get(code)
                    )
                ),
                "Condición": (
                    definition["Condición"]
                ),
                "Unidad": (
                    definition["Unidad"]
                ),
            }
        )

    return result
