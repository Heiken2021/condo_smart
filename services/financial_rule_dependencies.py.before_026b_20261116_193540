from datetime import date

from core.db import fetch_all
from services.financial_governance import (
    resolve_effective_rule,
)


def list_rule_dependencies(
    *,
    consumer_rule_code,
):
    return [
        dict(row)
        for row in fetch_all(
            """
            SELECT
                dependency.id,
                consumer.codigo
                    AS consumer_rule_code,
                source.codigo
                    AS source_rule_code,
                source.nombre
                    AS source_rule_name,
                dependency.criterion_code,
                dependency.criterion_label,
                dependency.source_parameter_code,
                dependency.required,
                dependency.active
            FROM financial_rule_dependencies
                dependency
            JOIN financial_rule_definitions
                consumer
              ON consumer.id=
                dependency.consumer_definition_id
            JOIN financial_rule_definitions
                source
              ON source.id=
                dependency.source_definition_id
            WHERE consumer.codigo=%s
              AND dependency.active=TRUE
            ORDER BY
                dependency.id
            """,
            (consumer_rule_code,),
        )
    ]


def preview_rule_dependencies(
    *,
    consumer_rule_code,
    property_id,
):
    dependencies = list_rule_dependencies(
        consumer_rule_code=consumer_rule_code,
    )

    result = []

    for dependency in dependencies:
        rows = fetch_all(
            """
            SELECT
                version.id AS version_id,
                version.version_num,
                version.estado_codigo,
                version.vigente_desde,
                version.vigente_hasta,
                version.parametros,
                rule.scope_level,
                rule.prioridad
            FROM financial_rule_versions version
            JOIN financial_rules rule
              ON rule.id=version.rule_id
            JOIN financial_rule_definitions
                definition
              ON definition.id=
                rule.rule_definition_id
            WHERE definition.codigo=%s
              AND rule.condominio_id=%s
              AND rule.activo=TRUE
            ORDER BY
                CASE version.estado_codigo
                    WHEN 'APROBADO' THEN 2
                    WHEN 'BORRADOR' THEN 1
                    ELSE 0
                END DESC,
                version.version_num DESC,
                version.id DESC
            LIMIT 1
            """,
            (
                dependency["source_rule_code"],
                property_id,
            ),
        )

        source = (
            dict(rows[0])
            if rows
            else None
        )

        value = None

        if source:
            parameters = (
                source.get("parametros")
                or {}
            )

            value = parameters.get(
                dependency[
                    "source_parameter_code"
                ]
            )

        result.append(
            {
                **dependency,
                "source_found": source is not None,
                "source_version_id": (
                    source["version_id"]
                    if source
                    else None
                ),
                "source_version_num": (
                    source["version_num"]
                    if source
                    else None
                ),
                "source_status": (
                    source["estado_codigo"]
                    if source
                    else None
                ),
                "inherited_value": value,
                "preview_only": (
                    source is not None
                    and source["estado_codigo"]
                    != "APROBADO"
                ),
                "ready_for_approval": (
                    source is not None
                    and source["estado_codigo"]
                    == "APROBADO"
                    and value is not None
                ),
            }
        )

    return result


def resolve_rule_dependencies(
    *,
    consumer_rule_code,
    property_id,
    actor_id,
    effective_date=None,
    space_id=None,
):
    effective_date = (
        effective_date
        or date.today()
    )

    dependencies = list_rule_dependencies(
        consumer_rule_code=consumer_rule_code,
    )

    resolved = []

    for dependency in dependencies:
        source = resolve_effective_rule(
            rule_code=(
                dependency["source_rule_code"]
            ),
            property_id=property_id,
            actor_id=actor_id,
            effective_date=effective_date,
            space_id=space_id,
        )

        value = None

        if source.get("found"):
            value = (
                source.get(
                    "effective_parameters",
                    {},
                ).get(
                    dependency[
                        "source_parameter_code"
                    ]
                )
            )

        item = {
            **dependency,
            "source_found": bool(
                source.get("found")
            ),
            "inherited_value": value,
            "source_rule_id": (
                source.get(
                    "selected_rule",
                    {},
                ).get("rule_id")
            ),
            "source_version_id": (
                source.get(
                    "selected_rule",
                    {},
                ).get("version_id")
            ),
            "source_version_num": (
                source.get(
                    "selected_rule",
                    {},
                ).get("version_num")
            ),
            "resolution_reason": (
                None
                if source.get("found")
                else source.get("reason")
            ),
        }

        item["resolved"] = (
            item["source_found"]
            and value is not None
        )

        resolved.append(item)

    return {
        "consumer_rule_code":
            consumer_rule_code,
        "effective_date": effective_date,
        "dependencies": resolved,
        "all_required_resolved": all(
            item["resolved"]
            for item in resolved
            if item["required"]
        ),
    }
