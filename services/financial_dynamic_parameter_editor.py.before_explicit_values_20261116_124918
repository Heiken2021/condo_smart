def parameter_label(code):
    return PARAMETER_LABELS.get(
        code,
        code.replace("_", " ").title(),
    )


def parameter_help(code):
    return PARAMETER_HELP.get(
        code,
        (
            "Valor configurable de esta regla. "
            "Debe respetar los límites definidos "
            "por el catálogo."
        ),
    )


def friendly_value(value):
    return VALUE_LABELS.get(
        str(value),
        str(value),
    )


def limits_text(specification):
    if not isinstance(
        specification,
        dict,
    ):
        return "Sin límites adicionales"

    parameter_type = specification.get(
        "type"
    )

    unit = specification.get(
        "unit"
    ) or specification.get(
        "currency"
    )

    allowed = (
        specification.get("allowed")
        or []
    )

    if allowed:
        return (
            "Opciones permitidas: "
            + ", ".join(
                friendly_value(value)
                for value in allowed
            )
        )

    minimum = specification.get(
        "minimum"
    )

    maximum = specification.get(
        "maximum"
    )

    pieces = []

    if minimum is not None:
        pieces.append(
            f"Mínimo {minimum}"
        )

    if maximum is not None:
        pieces.append(
            f"Máximo {maximum}"
        )

    if unit == "PERCENT":
        pieces = [
            f"{piece} %"
            for piece in pieces
        ]

    elif unit == "MXN":
        pieces = [
            f"{piece} MXN"
            for piece in pieces
        ]

    if pieces:
        return " · ".join(pieces)

    if parameter_type == "boolean":
        return "Sí o No"

    return "Sin límites adicionales"


def _number_default(
    *,
    specification,
    current_value,
):
    if current_value is not None:
        return float(current_value)

    minimum = specification.get(
        "minimum"
    )

    if minimum is not None:
        return float(minimum)

    return 0.0


def _integer_default(
    *,
    specification,
    current_value,
):
    if current_value is not None:
        return int(current_value)

    minimum = specification.get(
        "minimum"
    )

    if minimum is not None:
        return int(minimum)

    return 0


def render_parameter_inputs(
    *,
    schema,
    current_values=None,
    key_prefix,
):
    schema = (
        schema
        if isinstance(schema, dict)
        else {}
    )

    current_values = (
        current_values
        if isinstance(
            current_values,
            dict,
        )
        else {}
    )

    values = {}

    for code, specification in (
        schema.items()
    ):
        specification = (
            specification
            if isinstance(
                specification,
                dict,
            )
            else {}
        )

        label = parameter_label(code)

        help_text = parameter_help(code)

        parameter_type = (
            specification.get(
                "type",
                "string",
            )
        )

        optional = bool(
            specification.get(
                "optional",
                False,
            )
        )

        current_value = (
            current_values.get(code)
        )

        enabled = True

        if optional:
            enabled = st.checkbox(
                f"Configurar {label}",
                value=(
                    current_value
                    is not None
                ),
                key=(
                    f"{key_prefix}_"
                    f"{code}_enabled"
                ),
                help=(
                    "Este parámetro es opcional. "
                    "Actívalo únicamente si deseas "
                    "establecer un valor explícito."
                ),
            )

        if not enabled:
            continue

        unit = (
            specification.get("unit")
            or specification.get(
                "currency"
            )
        )

        if parameter_type == "number":
            minimum = specification.get(
                "minimum"
            )

            maximum = specification.get(
                "maximum"
            )

            display_label = label

            if unit == "PERCENT":
                display_label = (
                    f"{label} (%)"
                )

            elif unit == "MXN":
                display_label = (
                    f"{label} (MXN)"
                )

            values[code] = st.number_input(
                display_label,
                min_value=(
                    float(minimum)
                    if minimum is not None
                    else None
                ),
                max_value=(
                    float(maximum)
                    if maximum is not None
                    else None
                ),
                value=_number_default(
                    specification=specification,
                    current_value=current_value,
                ),
                step=(
                    0.5
                    if unit == "PERCENT"
                    else 0.01
                ),
                format="%.2f",
                key=(
                    f"{key_prefix}_{code}"
                ),
                help=(
                    help_text
                    + "\n\nLímites permitidos: "
                    + limits_text(
                        specification
                    )
                ),
            )

        elif parameter_type == "integer":
            minimum = specification.get(
                "minimum"
            )

            maximum = specification.get(
                "maximum"
            )

            values[code] = int(
                st.number_input(
                    label,
                    min_value=(
                        int(minimum)
                        if minimum is not None
                        else None
                    ),
                    max_value=(
                        int(maximum)
                        if maximum is not None
                        else None
                    ),
                    value=_integer_default(
                        specification=specification,
                        current_value=current_value,
                    ),
                    step=1,
                    key=(
                        f"{key_prefix}_{code}"
                    ),
                    help=(
                        help_text
                        + "\n\nLímites permitidos: "
                        + limits_text(
                            specification
                        )
                    ),
                )
            )

        elif parameter_type == "boolean":
            values[code] = st.toggle(
                label,
                value=bool(
                    current_value
                    if current_value
                    is not None
                    else False
                ),
                key=(
                    f"{key_prefix}_{code}"
                ),
                help=help_text,
            )

        elif parameter_type == "string":
            allowed = (
                specification.get(
                    "allowed"
                )
                or []
            )

            if allowed:
                index = 0

                if current_value in allowed:
                    index = allowed.index(
                        current_value
                    )

                values[code] = (
                    st.selectbox(
                        label,
                        allowed,
                        index=index,
                        format_func=(
                            friendly_value
                        ),
                        key=(
                            f"{key_prefix}_{code}"
                        ),
                        help=(
                            help_text
                            + "\n\n"
                            + limits_text(
                                specification
                            )
                        ),
                    )
                )

            else:
                values[code] = (
                    st.text_input(
                        label,
                        value=str(
                            current_value
                            or ""
                        ),
                        key=(
                            f"{key_prefix}_{code}"
                        ),
                        help=help_text,
                    )
                )

        else:
            raise ValueError(
                "UNSUPPORTED_PARAMETER_TYPE:"
                + str(parameter_type)
            )

    return values
