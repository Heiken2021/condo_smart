from pathlib import Path


LIFECYCLE = Path(
    "views/financial_rule_lifecycle.py"
).read_text(encoding="utf-8")

COMMANDS = Path(
    "services/financial_governance_commands.py"
).read_text(encoding="utf-8")


def test_draft_editor_is_connected():
    assert (
        "update_rule_version_draft,"
        in LIFECYCLE
    )

    assert (
        "def _render_edit_draft("
        in LIFECYCLE
    )


def test_edit_button_requires_draft():
    assert '"Editar borrador"' in LIFECYCLE
    assert "or draft is None" in LIFECYCLE


def test_edit_action_is_connected():
    assert (
        'action == "EDIT_DRAFT"'
        in LIFECYCLE
    )

    assert (
        "_render_edit_draft("
        in LIFECYCLE
    )


def test_editor_has_business_fields():
    for label in (
        "Importe (MXN)",
        "Frecuencia",
        "Día de vencimiento",
        "Vigente desde",
        "Motivo de modificación",
    ):
        assert label in LIFECYCLE


def testes():
    assert (
        "mientras la versión permanezca "
        in LIFECYCLE
    )

    assert (
        "Después de aprobarla"
        in LIFECYCLE
    )

    assert (
        "mediante una nueva "
        in LIFECYCLE
    )


def test_dynamic_validation_is_connected():
    assert (
        "def _validate_rule_parameters("
        in COMMANDS
    )

    assert (
        "esquema_parametros"
        in COMMANDS
    )


def test_business_percentages_are_not_hardcoded():
    forbidden = (
        "minimum_payment_percentage = 80",
        "pending_percentage = 20",
        "surcharge_percentage =",
    )

    for token in forbidden:
        assert token not in COMMANDS
