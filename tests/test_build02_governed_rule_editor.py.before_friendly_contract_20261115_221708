from pathlib import Path

from services.financial_rule_presenter import (
    parameter_schema_rows,
)


LIFECYCLE = Path(
    "views/financial_rule_lifecycle.py"
).read_text(encoding="utf-8")

GOVERNANCE = Path(
    "views/financial_governance.py"
).read_text(encoding="utf-8")


def test_priority_is_semantic():
    assert "PRIORITY_LEVELS" in LIFECYCLE
    assert '"Baja"' in LIFECYCLE
    assert '"Normal"' in LIFECYCLE
    assert '"Alta"' in LIFECYCLE
    assert '"Crítica"' in LIFECYCLE


def test_priority_values_are_internal():
    assert '"Baja": 100' in LIFECYCLE
    assert '"Normal": 200' in LIFECYCLE
    assert '"Alta": 300' in LIFECYCLE
    assert '"Crítica": 400' in LIFECYCLE


def test_free_numeric_priority_is_removed():
    assert (
        '"Prioridad",\n'
        '            min_value=1'
        not in LIFECYCLE
    )

    assert (
        '"Prioridad de aplicación"'
        in LIFECYCLE
    )


def test_priority_resolution_is_explained():
    assert (
        "alcance más específico"
        in LIFECYCLE
    )

    assert (
        "override explícito"
        in LIFECYCLE
    )


def test_definition_fields_have_popovers():
    assert (
        "def render_definition_field("
        in LIFECYCLE
    )

    assert "st.popover(" in LIFECYCLE

    for field in (
        "Código",
        "Nombre",
        "Dominio",
        "Tipo de resultado",
        "Aplicabilidad",
        "Nivel base",
        "Herencia",
        "Override",
    ):
        assert f'"{field}"' in LIFECYCLE


def test_governance_uses_definition_helper():
    assert (
        "render_definition_fields("
        in GOVERNANCE
    )


def test_technical_definition_is_read_only():
    assert (
        "Representación técnica de sólo"
        in GOVERNANCE
    )

    assert (
        "No se edita como "
        in GOVERNANCE
    )


def test_parameter_rows_have_descriptions():
    schema = {
        "amount": {
            "type": "number",
            "minimum": 0.01,
            "currency": "MXN",
        },
        "frequency": {
            "type": "string",
            "allowed": ["MENSUAL"],
        },
        "due_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "optional": True,
        },
    }

    rows = parameter_schema_rows(schema)

    assert len(rows) == 3

    for row in rows:
        assert row["Descripción"]


def test_rule_editor_does_not_edit_definition_json():
    forbidden = (
        "st.text_area(\n"
        '            "Esquema',
        "st.data_editor(",
    )

    for token in forbidden:
        assert token not in GOVERNANCE
