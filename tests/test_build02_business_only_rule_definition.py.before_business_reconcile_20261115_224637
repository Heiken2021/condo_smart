from pathlib import Path


VIEW = Path(
    "views/financial_governance.py"
).read_text(encoding="utf-8")


def test_rule_detail_has_business_tabs():
    for label in (
        "Definición",
        "Configuración",
        "Versiones",
        "Gobierno y auditoría",
    ):
        assert f'"{label}"' in VIEW


def test_raw_technical_json_is_not_visible():
    assert "st.json(schema)" not in VIEW
    assert (
        "Administración avanzada · "
        "Ver definición técnica"
        not in VIEW
    )


def test_internal_schema_is_explained():
    assert (
        "administrada internamente por "
        in VIEW
    )
    assert (
        "no forma parte de la configuración "
        in VIEW
    )


def test_configuration_explains_empty_state():
    assert (
        "Esta regla todavía no tiene "
        "una configuración creada."
        in VIEW
    )

    assert (
        "Importe, Frecuencia y Día "
        in VIEW
    )


def test_configuration_is_versioned():
    assert (
        "Una versión aprobada no se "
        in VIEW
    )
    assert (
        "creando una nueva versión."
        in VIEW
    )


def test_parameter_cards_remain_visible():
    for token in (
        "### 💰 Importe",
        "### 🔄 Frecuencia",
        "### 📅 Día de vencimiento",
    ):
        assert token in VIEW


def test_parameter_help_remains_available():
    block = VIEW[
        VIEW.index(
            "#### Parámetros configurables"
        ):
        VIEW.index(
            "with configuration_tab:"
        )
    ]

    assert block.count("st.popover(") >= 3


def test_ui_does_not_edit_schema():
    forbidden = (
        "st.data_editor(schema",
        'st.text_area("JSON',
        'st.text_area("Esquema',
    )

    for token in forbidden:
        assert token not in VIEW
