from pathlib import Path


VIEW = Path(
    "views/financial_governance.py"
).read_text(encoding="utf-8")


def test_parameter_experience_has_three_cards():
    assert "### 💰 Importe" in VIEW
    assert "### 🔄 Frecuencia" in VIEW
    assert (
        "### 📅 Día de vencimiento"
        in VIEW
    )


def test_parameters_have_help_popovers():
    block = VIEW[
        VIEW.index(
            "#### Parámetros configurables"
        ):
        VIEW.index(
            "with version_tab:"
        )
    ]

    assert block.count(
        "st.popover("
    ) >= 3


