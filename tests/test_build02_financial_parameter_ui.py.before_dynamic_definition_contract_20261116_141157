from pathlib import Path


VIEW = Path(
    "views/financial_governance.py"
).read_text(encoding="utf-8")


def test_parameter_experience_is_business_friendly():
    assert (
        "Parámetros configurables"
        in VIEW
    )

    for token in (
        "### 💰 Importe",
        "### 🔄 Frecuencia",
        "### 📅 Día de vencimiento",
    ):
        assert token in VIEW


def test_parameter_cards_have_help():
    start = VIEW.index(
        "#### Parámetros configurables"
    )

    end = VIEW.index(
        "with configuration_tab:",
        start,
    )

    block = VIEW[start:end]

    assert block.count(
        "st.popover("
    ) >= 3


def test_parameter_cards_explain_meaning():
    for token in (
        "El importe periódico de ",
        "La periodicidad con la que ",
        "El día límite de pago ",
    ):
        assert token in VIEW


def test_technical_definition_is_removed():
    assert "st.json(schema)" not in VIEW

    assert (
        "Ver definición técnica"
        not in VIEW
    )

    assert (
        "Administración avanzada"
        not in VIEW
    )


def test_configuration_tab_exists():
    assert (
        '"Configuración"'
        in VIEW
    )

    assert (
        "#### Configuración de la regla"
        in VIEW
    )


def test_version_values_are_supported():
    assert (
        "configured_parameter_rows("
        in VIEW
    )

    assert (
        "Valores de la versión"
        in VIEW
    )


def test_business_labels_are_used():
    assert (
        "business_status("
        in VIEW
    )

    assert (
        "business_scope("
        in VIEW
    )


def test_parameter_ui_remains_governed():
    forbidden = (
        "st.json(schema)",
        "st.data_editor(schema",
    )

    for token in forbidden:
        assert token not in VIEW
