def test_parameter_cards_are_visible():
    for token in (
        "### 💰 Importe",
        "### 🔄 Frecuencia",
        "### 📅 Día de vencimiento",
    ):
        assert token in VIEW


def test_parameter_help_is_available():
    start = VIEW.index(
        "#### Parámetros configurables"
    )

    end = VIEW.index(
        "with configuration_tab:",
        start,
    )

    block = VIEW[start:end]

    assert block.count(
        "st.popover("
    ) >= 3

    assert block.count(
        '"ⓘ"'
    ) >= 3


def test_parameter_cards_have_examples():
    for token in (
        "Ejemplo: si la cuota mensual ",
        "Para mantenimiento ordinario, ",
        "Ejemplo: configurar 10 ",
    ):
        assert token in VIEW


def test_ui_does_not_edit_schema():
    forbidden = (
        "st.json(schema)",
        "st.data_editor(schema",
        'st.text_area("JSON',
        'st.text_area("Esquema',
    )

    for token in forbidden:
        assert token not in VIEW
